[Unit]
Description=Install eligible kernel updates and perform guarded kernel reboot
After=network-online.target lksu-verify.service
Wants=network-online.target lksu-verify.service
# A pending kernel trial must be verified before a timed maintenance job may run.

[Service]
Type=oneshot
ExecStart=/usr/local/bin/lksu maintenance
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes

