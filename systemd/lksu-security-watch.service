[Unit]
Description=LKSU lightweight security watch and alerting
After=network-online.target auditd.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/lksu security-check
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
# systemd must create this directory before resolving mount namespace paths.
# First-install security checks may run before any kernel update creates state.json.
StateDirectory=lksu
StateDirectoryMode=0700
ReadWritePaths=/var/lib/lksu

